# Environment Variables Example

# SQLite (Default zero-config local file)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Alternative for production deployment e.g. Neon, Supabase, RDS)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/blog_db?schema=public"

# Session & JWT Security (Generate a random 32+ character hex string in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Base URL for Canonical and OpenGraph SEO generation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Initial Credentials
ADMIN_NAME="StateToState Admin"
ADMIN_EMAIL="admin@statetostate.com"
ADMIN_PASSWORD="AdminPassword123!"

# Google AdSense Publisher ID (Fill when approved: e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Optional: Cloudinary credentials for media upload
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"
